{
  "name": "@ielts/extension",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "node scripts/build.mjs",
    "build:production": "node scripts/build.mjs production",
    "package": "pnpm build && node scripts/package.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no linter configured'",
    "test": "vitest run --reporter verbose",
    "ai": "echo 'no tests configured'",
    "clean": "rm -rf dist",
    "clean:all": "rm -rf dist *.zip"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@ielts/ai": "workspace:*",
    "@ielts/ai-tutor-engine": "workspace:*",
    "@ielts/config": "workspace:*",
    "@ielts/learning-engine": "workspace:*",
    "@ielts/shared": "workspace:*",
    "@ielts/settings": "workspace:*",
    "@ielts/storage": "workspace:*",
    "@ielts/theme": "workspace:*",
    "@ielts/ui": "workspace:*",
    "dexie": "^4.4.4",
    "lucide-react": "^1.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.80.0",
    "react-router-dom": "^7.5.0",
    "recharts": "^2.15.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/chrome": "^0.0.308",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "^0.25.2",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.3",
    "vitest": "^3.1.1"
  }
}
